{
    "name": "arisultima/overwatch-laravel-agent",
    "description": "Counts what happens inside a Laravel app and pushes one small report a minute to an Overwatch server.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "monitoring", "observability", "overwatch"],
    "authors": [
        {
            "name": "aris"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/horizon": "Adds a horizon health check and supervisor status to each report.",
        "laravel/pulse": "Detected at run time only; nothing is read from it unless present.",
        "laravel/fortify": "Counts failed two-factor challenges from its events.",
        "spatie/laravel-permission": "Counts role and permission changes from its events.",
        "sat/diagnostics": "Shares the same exception fingerprint, so error groups line up across both."
    },
    "autoload": {
        "psr-4": {
            "Arisultima\\OverwatchAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arisultima\\OverwatchAgent\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arisultima\\OverwatchAgent\\OverwatchAgentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
